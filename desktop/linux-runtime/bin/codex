#!/bin/sh
set -eu

resources=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
system_codex=${CHATGPT_LINUX_SYSTEM_CODEX:-}
if [ -z "$system_codex" ]; then
  bundled_codex="$resources/app/vendor-app/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/bin/codex"
  if [ -x "$bundled_codex" ]; then
    system_codex=$bundled_codex
  else
    system_codex=/usr/local/bin/codex
  fi
fi
export CHATGPT_LINUX_SYSTEM_CODEX="$system_codex"
exec "$system_codex" \
  -c "mcp_servers.node_repl.command=\"$resources/cua_node/bin/node_repl\"" \
  -c 'mcp_servers.node_repl.args=[]' \
  "$@"
