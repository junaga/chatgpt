{
  "name": "chatgpt-linux",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "port": "tsx src/cli.ts",
    "port:container": "./scripts/build-container.sh",
    "release": "./scripts/release.sh",
    "test": "npm run typecheck && npm run test:tool",
    "test:tool": "tsx --test test/*.test.ts",
    "test:installed": "npm test --prefix desktop",
    "test:live": "npm run test:live --prefix desktop",
    "test:container": "./scripts/test-container.sh local",
    "test:container:live": "./scripts/test-container.sh live",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@electron/asar": "4.2.1",
    "@types/node": "24.10.0",
    "electron-builder": "26.15.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
